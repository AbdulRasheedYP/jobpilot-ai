# JobPilot AI --- Environment Variables Template
# Copy this file to .env and adjust values for your environment.

# Application Settings
APP_NAME="JobPilot AI"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (PostgreSQL)
# For local native Ubuntu PostgreSQL:
DATABASE_URL=postgresql://jobpilot:jobpilot_secret@localhost:5432/jobpilot
# For Docker Compose:
# POSTGRES_USER=jobpilot
# POSTGRES_PASSWORD=jobpilot_secret
# POSTGRES_DB=jobpilot
# POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Storage Paths
UPLOAD_DIR=./storage/uploads
RESUME_STORAGE_DIR=./storage/resumes

# Permitted Job API Keys (Optional/Configurable)
# ADZUNA_APP_ID=your_app_id_here
# ADZUNA_APP_KEY=your_app_key_here
