# JobPilot AI --- Environment Variables Template (Cloud-Hosted)
# Copy this file to .env and adjust values for your environment.

# Application Settings
APP_NAME="JobPilot AI"
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://jobpilot:jobpilot_secret@localhost:5432/jobpilot
# For Docker Compose internal network:
# DATABASE_URL=postgresql://jobpilot:jobpilot_secret@postgres:5432/jobpilot

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# For Docker Compose internal network:
# REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration
# Options: 'gemini' | 'groq' | 'openai' | 'ollama'
LLM_PROVIDER=gemini

# Google Gemini API (Recommended: ultra-fast, high accuracy, free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API (Alternative cloud provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (Optional alternative)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Self-Hosted Ollama (Optional - for high-RAM VPS or local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Storage Paths (Local or mounted volume on VPS)
UPLOAD_DIR=./storage/uploads
RESUME_STORAGE_DIR=./storage/resumes

# Permitted Job API Keys (Optional/Configurable)
# ADZUNA_APP_ID=your_app_id_here
# ADZUNA_APP_KEY=your_app_key_here
