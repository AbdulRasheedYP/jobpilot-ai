# ==============================================================================
# JobPilot AI — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values. DO NOT commit .env to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="JobPilot AI"
APP_ENV=production                  # 'development' | 'production' | 'test'
DEBUG=false                         # Set to 'false' in production
API_V1_PREFIX=/api/v1
SECRET_KEY="generate-a-long-random-string-here"  # e.g., openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ------------------------------------------------------------------------------
# 2. CORS (Allowed Frontend Domains)
# Comma-separated list of origins permitted to communicate with backend
# Include your Vercel deployment URL here:
# ------------------------------------------------------------------------------
ALLOWED_CORS_ORIGINS="http://localhost:3000,https://your-jobpilot-app.vercel.app,https://*.vercel.app"

# ------------------------------------------------------------------------------
# 3. DATABASE (Neon Postgres or Local PostgreSQL)
# For Neon Postgres, copy your connection string from the Neon Console:
# Example: postgresql+psycopg://username:password@ep-cool-fog-12345.aws.neon.tech/neondb?sslmode=require
# Note: If your Neon URL starts with postgres://, it will be automatically converted to postgresql+psycopg://
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+psycopg://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 4. LLM PROVIDERS
# Set LLM_PROVIDER to 'gemini' (Recommended free tier) | 'groq' | 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=""                   # Get from https://aistudio.google.com/
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative LLMs:
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. RESUME CLOUD STORAGE (Cloudinary)
# Sign up at https://cloudinary.com/ (Free Tier) to get your credentials.
# If left blank, resumes are securely stored on the local container filesystem.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=cloudinary          # 'cloudinary' | 'local'
CLOUDINARY_CLOUD_NAME=""            # From Cloudinary Dashboard
CLOUDINARY_API_KEY=""               # From Cloudinary Dashboard
CLOUDINARY_API_SECRET=""            # From Cloudinary Dashboard
CLOUDINARY_FOLDER="jobpilot/resumes"

# ------------------------------------------------------------------------------
# 6. CACHE & BACKGROUND JOBS (Optional for Redis/Celery workers)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ------------------------------------------------------------------------------
# 7. FRONTEND VERCEL ENVIRONMENT VARIABLE
# In Vercel Project Settings -> Environment Variables, add:
# VITE_API_URL="https://your-backend-service.onrender.com"
# ------------------------------------------------------------------------------
